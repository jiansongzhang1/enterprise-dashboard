                  "pm.test('code = 200', () => pm.expect(j.code).to.eql(200));",
                  "const b = j.data.blocks.METRICS;",
                  "pm.test('默认 10 张卡', () => pm.expect(b.items.length).to.eql(10));",
                  "pm.test('监控字段为 null', () => { pm.expect(j.data.monitoring).to.eql(null); pm.expect(j.data.anomalies).to.eql(null); b.items.forEach(c => pm.expect(c.alert).to.eql(null)); });",
                  "pm.test('数据未接入提示', () => pm.expect(j.data.notices.map(n => n.code)).to.include('PROMO_DATA_PENDING'));",
                  "pm.test('含今天：compare.cutAt 有值', () => pm.expect(j.data.compare.cutAt).to.match(/^\\d{2}:\\d{2}$/));"
