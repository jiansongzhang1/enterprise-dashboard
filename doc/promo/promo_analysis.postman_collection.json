{
  "info": {
    "name": "推广分析 · 后端接口（UDS 未接入版）",
    "description": "推广分析 FY-46 的接口联调：概览（scene = PROMO）、渠道表现、获客与留存、裂变层级、投放日报导出（FY-57）、用户明细的终端与推广筛选、预算与消耗 6 列模板。\n\n全部只读（不写库）。UDS 推广数据未接入：数值为 null、列表为空，dataPending = true。\n\n执行前：先执行 sql/release_next_postgresql.sql ⑤；在「系统管理 › 配置中心」把 PROMO_CHANNELS 改成带 id 的格式，并新增 PROMO_TERMINALS（示例在新增页）。\n变量：baseUrl、username、password、totp（或直接填 token 跳过 0.1）、siteCode；tzOffsetMin 为站点时区相对 UTC 的分钟数（印度 330）。\n权限：dashboard:promo:view、dashboard:record:member、promo:budget:view。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 按站点时区算日期；默认 Asia/Kolkata（UTC+5:30），其他站点改 tzOffsetMin",
          "const off = parseInt(pm.collectionVariables.get('tzOffsetMin') || '330', 10);",
          "const now = new Date(Date.now() + off * 60000);",
          "const d = (days) => { const x = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + days)); return x.toISOString().slice(0, 10); };",
          "pm.collectionVariables.set('todayDate', d(0));",
          "pm.collectionVariables.set('yesterday', d(-1));",
          "pm.collectionVariables.set('todayStart', d(0) + ' 00:00');",
          "pm.collectionVariables.set('todayEnd', d(1) + ' 00:00');",
          "pm.collectionVariables.set('d7From', d(-6) + ' 00:00');",
          "pm.collectionVariables.set('reg30From', d(-30));",
          "pm.collectionVariables.set('reg90From', d(-90));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. 准备",
      "item": [
        {
          "name": "0.1 登录（获取 token）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Site-Code",
                "value": "{{siteCode}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"code\": \"{{totp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "code 为 Google Authenticator 6 位动态码，执行前在变量 totp 填好。已有 token 可直接填变量 token 并跳过本请求。",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('code = 200', () => pm.expect(j.code).to.eql(200));",
                  "pm.test('拿到 token', () => pm.expect(j.token).to.be.a('string').and.not.empty);",
                  "if (j.token) pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. 公共选项",
      "item": [
        {
          "name": "1.1 推广分析选项 options",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Site-Code",
                "value": "{{siteCode}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/dashboard/promo/options"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ct = pm.response.headers.get('Content-Type') || '';",
                  "const j = pm.response.json();",
                  "pm.test('code = 200', () => pm.expect(j.code).to.eql(200));",
                  "pm.test('有 agents / terminals / metrics', () => { pm.expect(j.data.agents).to.be.an('array'); pm.expect(j.data.terminals).to.be.an('array'); pm.expect(j.data.metrics).to.be.an('array'); });",
                  "const a = (j.data.agents || [])[0]; if (a) { pm.collectionVariables.set('agentId', a.code); if (a.channels[0]) pm.collectionVariables.set('channelId', a.channels[0].code); }",
                  "const t = (j.data.terminals || [])[0]; if (t) pm.collectionVariables.set('terminal', t.code);",
                  "pm.test('metrics 16 个（执行过 release_next ⑤）', () => pm.expect(j.data.metrics.length).to.eql(16));"
                ]
              }
            }
          ]
        }
      ]
    },
