{
	"info": {
		"_postman_id": "4f84b879-9f2c-49cb-aed5-827a5d8ab754",
		"name": "Fivetech Dashboard API · 系统管理 · 指标管理（口径与取数方式）",
		"description": "覆盖 GET /system/metrics、/system/metrics/{code}，POST /system/metrics、/{code}/update、/{code}/delete。\n前提：已执行 sql/alter_metric_card_dictionary_postgresql.sql、sql/add_metric_manage_menu_postgresql.sql，token 账号有 system:metric:*。\n第 10～14 步登记一个临时指标再删除，不会留下数据；第 5 步把投注总额的口径改回原值。",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// 若依统一返回：HTTP 恒为 200，成败看 code",
					"pm.test('HTTP 200', () => pm.response.to.have.status(200));"
				]
			}
		}
	],
	"item": [
		{
			"name": "1. 列表（全部）",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/system/metrics"
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const j = pm.response.json();",
							"pm.test('code = 200', () => pm.expect(j.code).to.eql(200));",
							"const d = j.data;",
							"pm.test('结构', () => pm.expect(d).to.include.all.keys('rows','total','groups','datasets'));",
							"pm.test('datasets 指向三个 v2 数据集', () => { pm.expect(d.datasets.udsHourField).to.eql('dashboard_overview_hour_v2'); pm.expect(d.datasets.udsDayField).to.eql('dashboard_overview_day_v2'); pm.expect(d.datasets.udsAmountField).to.eql('dashboard_overview_amount_v2'); });",
							"const live = d.rows.filter(r => r.status === '0');",
							"pm.test('已接入 28 个指标（执行字典 SQL 后）', () => pm.expect(live.length).to.eql(28));",
							"pm.test('口径都已填写（口径：开头）', () => live.forEach(r => pm.expect(r.remark || '', r.metricCode).to.match(/^口径：/)));",
							"pm.test('表与线上配置一致（configMismatch 为空）', () => live.forEach(r => pm.expect(r.configMismatch, r.metricCode).to.eql([])));",
							"const by = c => d.rows.find(r => r.metricCode === c);",
							"pm.test('活跃人数：小时 active_hour、日 active_day、基准 active_hour_baseline', () => { const a = by('active'); pm.expect(a.udsHourField).to.eql('active_hour'); pm.expect(a.udsDayField).to.eql('active_day'); pm.expect(a.udsBaselineField).to.eql('active_hour_baseline'); });",
							"pm.test('存提差、NGR、派彩由后端组装', () => { pm.expect(by('net').config.assemble).to.eql('dep − wd'); pm.expect(by('ngr').config.assemble).to.eql('ggr − bonus'); pm.expect(by('pay').config.assemble).to.eql('bet + winLoss'); });",
							"pm.test('引用：dep 被 net 等引用、页面含 OVERVIEW', () => { pm.expect(by('dep').usedBy).to.include('net'); pm.expect(by('dep').pages).to.include('OVERVIEW'); });",
							"pm.test('已接入的都不能删', () => live.forEach(r => pm.expect(r.deletable, r.metricCode).to.eql(false)));"
						]
					}
				}
			]
		},
