<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 运营总览异常提醒条（anomalies）：只读，全部带站点数据范围 -->
<mapper namespace="com.fivetech.monitor.mapper.MonitorOverviewMapper">

	<resultMap type="com.fivetech.monitor.domain.MonitorOverviewEvent" id="OverviewEventResult">
		<id     property="eventId"        column="event_id"        />
		<result property="ruleId"         column="rule_id"         />
		<result property="ruleNo"         column="rule_no"         />
		<result property="metricCode"     column="metric_code"     />
		<result property="metricName"     column="metric_name"     />
		<result property="valueFormat"    column="value_format"    />
		<result property="level"          column="level"           />
		<result property="escalated"      column="escalated"       />
		<result property="startHour"      column="start_hour"      />
		<result property="lastPeriodEnd"  column="last_period_end" />
		<result property="ruleSnapshot"   column="rule_snapshot"   />
		<result property="recentPeriods"  column="recent_periods"  />
	</resultMap>

	<select id="countEnabledRules" resultType="java.lang.Integer">
		select count(*)
		  from monitor_rule r
		 where r.del_flag = '0'
		   and r.enabled = true
		<include refid="com.fivetech.monitor.mapper.MonitorCommon.monitorScopeFilter">
			<property name="alias" value="r"/>
		</include>
	</select>

	<select id="selectOpenEvents" resultMap="OverviewEventResult">
		select e.event_id, e.rule_id, r.rule_no, e.metric_code,
		       coalesce(c.metric_name, e.metric_code) as metric_name, c.value_format,
		       e.level, e.escalated, e.start_hour, e.last_period_end,
		       e.rule_snapshot::text as rule_snapshot, s.recent_periods::text as recent_periods
		  from monitor_event e
		  left join monitor_rule r on r.rule_id = e.rule_id and r.site_code = e.site_code
		  left join dashboard_metric_card c on c.metric_code = e.metric_code
		  left join monitor_rule_state s on s.rule_id = e.rule_id and s.site_code = e.site_code
		 where e.event_type = 'alert'
		   and e.status = 'open'
		<include refid="com.fivetech.monitor.mapper.MonitorCommon.monitorScopeFilter">
			<property name="alias" value="e"/>
		</include>
	</select>

	<select id="countPendingEvents" resultType="java.lang.Integer">
		select count(*)
		  from monitor_event e
		 where e.event_type = 'alert'
		   and e.handle_status = 'pending'
		<include refid="com.fivetech.monitor.mapper.MonitorCommon.monitorScopeFilter">
			<property name="alias" value="e"/>
		</include>
	</select>

	<select id="selectLastJudgedHour" resultType="java.time.LocalDateTime">
		select max(h.data_hour)
		  from monitor_hour_check h
		 where h.status = 'judged'
		<include refid="com.fivetech.monitor.mapper.MonitorCommon.monitorScopeFilter">
			<property name="alias" value="h"/>
		</include>
	</select>

	<resultMap type="com.fivetech.monitor.domain.MonitorCardRule" id="CardRuleResult">
		<id     property="ruleId"             column="rule_id"               />
		<result property="ruleNo"             column="rule_no"               />
		<result property="metricCode"         column="metric_code"           />
		<result property="valueFormat"        column="value_format"          />
		<result property="enabled"            column="enabled"               />
		<result property="judgeType"          column="judge_type"            />
		<result property="warnLow"            column="warn_low"              />
		<result property="warnHigh"           column="warn_high"             />
		<result property="critLow"            column="crit_low"              />
		<result property="critHigh"           column="crit_high"             />
		<result property="periodHours"        column="period_hours"          />
		<result property="durationCount"      column="duration_count"        />
		<result property="escalateHours"      column="escalate_hours"        />
		<result property="minSampleKey"       column="min_sample_key"        />
		<result property="minSampleValue"     column="min_sample_value"      />
		<result property="recentPeriods"      column="recent_periods"        />
		<result property="eventId"            column="event_id"              />
		<result property="eventLevel"         column="event_level"           />
		<result property="eventEscalated"     column="event_escalated"       />
		<result property="eventStartHour"     column="event_start_hour"      />
		<result property="eventTriggerHour"   column="event_trigger_hour"    />
		<result property="eventLastPeriodEnd" column="event_last_period_end" />
		<result property="eventRuleSnapshot"  column="event_rule_snapshot"   />
	</resultMap>

	<select id="selectCardRules" resultMap="CardRuleResult">
		select r.rule_id, r.rule_no, r.metric_code, c.value_format, r.enabled,
		       r.judge_type, r.warn_low, r.warn_high, r.crit_low, r.crit_high,
		       r.period_hours, r.duration_count, r.escalate_hours, r.min_sample_key, r.min_sample_value,
		       s.recent_periods::text as recent_periods,
		       e.event_id, e.level as event_level, e.escalated as event_escalated,
		       e.start_hour as event_start_hour, e.trigger_hour as event_trigger_hour,
		       e.last_period_end as event_last_period_end, e.rule_snapshot::text as event_rule_snapshot
		  from monitor_rule r
		  left join dashboard_metric_card c on c.metric_code = r.metric_code
		  left join monitor_rule_state s on s.rule_id = r.rule_id and s.site_code = r.site_code
		  left join monitor_event e on e.rule_id = r.rule_id and e.site_code = r.site_code
		                           and e.event_type = 'alert' and e.status = 'open'
		 where r.del_flag = '0'
		<include refid="com.fivetech.monitor.mapper.MonitorCommon.monitorScopeFilter">
			<property name="alias" value="r"/>
		</include>
		 order by r.rule_no
	</select>

</mapper>
