<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>fivetech</artifactId>
        <groupId>com.fivetech</groupId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>fivetech-system</artifactId>

    <description>
        system系统模块
    </description>

    <dependencies>

        <!-- 通用工具-->
        <dependency>
            <groupId>com.fivetech</groupId>
            <artifactId>fivetech-common</artifactId>
        </dependency>

        <!-- 订单规则变更事件发到 MSK（没配 spring.kafka.bootstrap-servers 时不装配，见 OrderRuleEventPublisher）。
             必须用 Boot 的 starter：Spring Boot 4 把自动配置拆成了独立模块，只加 spring-kafka 不会有 KafkaTemplate Bean -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <!-- MSK 的 IAM 认证；走实例角色取临时凭证，代码里不配密钥 -->
        <dependency>
            <groupId>software.amazon.msk</groupId>
            <artifactId>aws-msk-iam-auth</artifactId>
        </dependency>

        <!-- 单元测试（版本由 spring-boot-dependencies 管理）：目前只有 MonitorMapperScopeTest -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>